{
  "name": "@nomol/native",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "prebuild": "pnpm --filter @nomol/native-modules specs && expo prebuild --platform android --no-install",
    "build": "pnpm prebuild && cd android && JAVA_HOME=${JAVA_HOME:-/usr/lib/jvm/java-21-openjdk} ANDROID_HOME=${ANDROID_HOME:-/opt/android-sdk} ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "install:apk": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@nomol/core": "workspace:*",
    "@nomol/native-modules": "workspace:*",
    "expo": "~58.0.25",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.13",
    "expo-keep-awake": "~58.0.4",
    "expo-navigation-bar": "~58.0.4",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-vision-camera": "5.2.4",
    "react-native-vision-camera-worklets": "5.2.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "typescript": "^5.9.3"
  }
}
