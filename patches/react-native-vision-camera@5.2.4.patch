--- a/android/src/main/java/com/margelo/nitro/camera/hybrids/outputs/HybridVideoOutput.kt
+++ b/android/src/main/java/com/margelo/nitro/camera/hybrids/outputs/HybridVideoOutput.kt
@@ -88,6 +88,15 @@ class HybridVideoOutput(
           // chosen Quality's typical size, e.g. SD@640x480 + RATIO_16_9 → 640x360.
           val qualitySelector = options.targetResolution.toQualitySelector()
           setQualitySelector(qualitySelector)
+
+          // Nomol: a 4:3 target records 4:3 (e.g. FHD as 1440x1080), like the preview and the
+          // frame output. Without an aspect ratio CameraX picks the quality's 16:9 size, which
+          // cuts off part of what the preview shows and where the poses were detected.
+          val target = options.targetResolution
+          val ratio = maxOf(target.width, target.height) / minOf(target.width, target.height)
+          if (kotlin.math.abs(ratio - 4.0 / 3.0) < 0.01) {
+            setAspectRatio(androidx.camera.core.AspectRatio.RATIO_4_3)
+          }
         }.build()
   }
 
