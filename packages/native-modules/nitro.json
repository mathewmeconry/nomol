{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["nomol"],
  "ios": {
    "iosModuleName": "NomolNative"
  },
  "android": {
    "androidNamespace": ["nomol"],
    "androidCxxLibName": "NomolNative"
  },
  "autolinking": {
    "PoseLandmarker": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPoseLandmarker"
      }
    },
    "SkeletonLandmarker": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridSkeletonLandmarker"
      }
    },
    "StartSound": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridStartSound"
      }
    },
    "ClipRecorder": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridClipRecorder"
      }
    },
    "FileShare": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridFileShare"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
