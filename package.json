{
  "name": "nomol",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @nomol/web build",
    "dev": "pnpm --filter @nomol/web dev",
    "preview": "pnpm --filter @nomol/web preview",
    "android:build": "pnpm --filter @nomol/native build",
    "android:install": "pnpm --filter @nomol/native install:apk",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --max-warnings=0 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --parallel test",
    "test:ci": "pnpm -r test:ci",
    "coverage": "pnpm -r coverage",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "knip": "^6.44.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
