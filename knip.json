{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "ignoreBinaries": ["adb"],
  "workspaces": {
    "apps/web": {
      "entry": ["public/sw.js"]
    },
    "apps/native": {
      "entry": ["plugins/*.js"],
      "ignoreDependencies": ["react-native-vision-camera-worklets"]
    },
    "packages/native-modules": {
      "entry": ["react-native.config.js", "src/specs/*.nitro.ts"]
    },
    "packages/core": {}
  },
  "ignoreIssues": { "apps/web/app/components/ui/*": ["exports"] }
}
