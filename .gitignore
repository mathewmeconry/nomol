.DS_Store
node_modules/
coverage/

# Recordings and exported test data contain people; never commit them.
*.mp4
*.webm
*.mov
*.mjpeg
*.y4m
*.nomol.json
*.nomol.txt

# Env
.env*
!.env.example

# Expo: android/ is generated by `expo prebuild` (continuous native generation)
/apps/native/android/
/apps/native/ios/
.expo/
# Native module: nitrogen's code is generated before each build, the MediaPipe models (~36 MB)
# are downloaded by it
/packages/native-modules/nitrogen/
/packages/native-modules/android/build/
/packages/native-modules/android/.cxx/
/packages/native-modules/android/models/
*.apk
*.aab

# React Router
.react-router/
/apps/*/build/

# AI tools (skills are restored from skills-lock.json)
.claude/worktrees/
.claude/skills/
.claude/launch.json
